# Server Configuration (mcp-service-kit)
MCP_TRANSPORT=http
MCP_HOST=localhost
MCP_PORT=3000
MCP_AUTH_ENABLED=false

# Web Search Configuration
# Optional: adds the official Brave Search API to the engines queried in parallel
BRAVE_API_KEY=
MAX_CONTENT_LENGTH=500000
MAX_CONCURRENT_REQUESTS=5
# ddgs backend(s), e.g. auto or duckduckgo,bing
DDGS_BACKEND=auto
# Seconds to wait for each engine queried in parallel
ENGINE_TIMEOUT_SECONDS=10
# Allow fetching loopback/private/link-local URLs (only on trusted networks)
ALLOW_PRIVATE_URLS=false

# Docker-specific
UV_CACHE_DIR=/tmp/uv-cache
